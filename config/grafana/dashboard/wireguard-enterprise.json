{
  "title": "QuantumTunnel Enterprise WireGuard Telemetry",
  "uid": "quantumtunnel-wg-main",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 1,
      "title": "Active Provisioned Peers",
      "type": "stat",
      "targets": [
        {
          "expr": "count(wireguard_latest_handshake_seconds)",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Tunnel Receive Throughput (bps)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(wireguard_received_bytes_total[1m]) * 8",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 }
    },
    {
      "id": 3,
      "title": "Tunnel Transmit Throughput (bps)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(wireguard_sent_bytes_total[1m]) * 8",
          "refId": "A"
        }
      ],
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 }
    }
  ]
}
