# ============================================================================
# QuantumTunnel Enterprise Production Environment Template (.env.example)
# Copy to .env and set permissions: chmod 600 .env
# Works on both Ubuntu 24.04 VPS and Android Termux!
# ============================================================================

# --- 1. Server Network Settings ---
WG_HOST=vpn.example.com
WG_PORT=51820
WG_INTERFACE=wg0
WG_IPV4_SUBNET=10.66.66.0/24
WG_IPV4_GATEWAY=10.66.66.1
WG_IPV6_SUBNET=fd42:42:42::/64
WG_IPV6_GATEWAY=fd42:42:42::1
WG_MTU=1420
WG_PERSISTENT_KEEPALIVE=25
PUBLIC_INTERFACE=eth0

# --- 2. DNS & Leak Protection ---
# Options:
#   Cloudflare Zero-Log (Default): 1.1.1.1,1.0.0.1
#   Cloudflare Malware Blocking : 1.1.1.2,1.0.0.2
#   Quad9 Threat Blocking       : 9.9.9.9,149.112.112.112
#   Mullvad Ad/Tracker Blocking : 194.242.2.2
WG_DNS_PRIMARY=1.1.1.1,1.0.0.1
WG_DNS_IPV6=2606:4700:4700::1111,2606:4700:4700::1001

# --- 3. Administration & Zero-Trust MFA ---
SSH_PORT=2222
VPS_USER=ubuntu
ADMIN_ALLOWED_CIDR=203.0.113.10/32
OIDC_ISSUER_URL=https://idp.example.com/oauth2/default
OIDC_CLIENT_ID=quantumtunnel-enterprise

# --- 4. Monitoring Stack (Prometheus & Grafana) ---
GRAFANA_ADMIN_USER=secops-admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_Via_GitHub_Secrets
PROMETHEUS_RETENTION=15d

# --- 5. Encrypted Backups ---
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME_Via_GitHub_Secrets
