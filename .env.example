# ============================================================================
# QuantumTunnel / WireGuard Enterprise Production Environment Template (.env.example)
# Copy to .env and set permissions: chmod 600 .env
# Works on both Ubuntu 24.04 VPS and Android Termux!
# ============================================================================

WG_HOST=vpn.example.com
WG_PORT=51820
WG_INTERFACE=wg0
WG_IPV4_SUBNET=10.66.66.0/24
WG_IPV4_GATEWAY=10.66.66.1
WG_IPV6_SUBNET=fd42:42:42::/64
WG_IPV6_GATEWAY=fd42:42:42::1
WG_MTU=1420
WG_PERSISTENT_KEEPALIVE=25
PUBLIC_INTERFACE=eth0

# DNS & Leak Protection
WG_DNS_PRIMARY=1.1.1.1,1.0.0.1
WG_DNS_IPV6=2606:4700:4700::1111,2606:4700:4700::1001

# Administration & Zero-Trust MFA
SSH_PORT=2222
VPS_USER=ubuntu
ADMIN_ALLOWED_CIDR=203.0.113.10/32

# Monitoring Stack (Prometheus & Grafana)
GRAFANA_ADMIN_USER=secops-admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_Via_GitHub_Secrets
PROMETHEUS_RETENTION=15d

# Encrypted Backups
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME_Via_GitHub_Secrets
